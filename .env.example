# ==========================================================================
# n8n — modo fila com task-runners (self-hosted, Docker)
# --------------------------------------------------------------------------
# COPIE este arquivo para `.env` e preencha os segredos:
#
#   cp .env.example .env
#
# Gere cada segredo com (um comando por segredo):
#   openssl rand -hex 32
#
# O `.env` real é gitignored — só ESTE arquivo (placeholders) vai pro git.
# Os scripts se recusam a rodar enquanto houver GERE_*/TROQUE_* aqui.
# ==========================================================================

# --- Versões (pinadas: o mesmo comando sobe o mesmo ambiente amanhã) -------
# editor, worker, webhook e runner PRECISAM estar na mesma versão do n8n.
N8N_VERSION=2.11.3
POSTGRES_IMAGE=pgvector/pgvector:pg18-trixie
REDIS_VERSION=8.8.0
TRAEFIK_VERSION=v3.7.7

# --- Domínios locais (*.localhost resolve para 127.0.0.1 sem mexer no /etc/hosts)
N8N_EDITOR_HOST=n8n.localhost
N8N_WEBHOOK_HOST=ws.localhost

# --- Geral -----------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
# Onde ficam os dados persistentes (bind mounts). Padrão: ~/storage
STORAGE_DIR=~/storage

# --- PostgreSQL (fonte da verdade: workflows, credentials, execuções) ------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=n8n

# --- Segredo mestre que cifra as CREDENTIALS no Postgres -------------------
# CRÍTICO: IGUAL em editor + worker + webhook, e FIXO para sempre.
# Perdeu esta chave = todas as credentials salvas viram lixo ilegível.
# Faça backup dela junto com o backup do banco.
N8N_ENCRYPTION_KEY=GERE_UMA_CHAVE_ALEATORIA

# --- Token que autentica worker <-> task-runner ----------------------------
N8N_RUNNERS_AUTH_TOKEN=GERE_OUTRO_TOKEN
